# Copiar a .env si deseas cambiar los valores predeterminados.
OLLAMA_BASE_URL=http://127.0.0.1:11434
CHAT_MODEL=gemma3:1b
EMBEDDING_MODEL=embeddinggemma:latest
TOP_K=5
REQUEST_TIMEOUT=180
# Opcional: rechazar fragmentos cuya distancia coseno supere este valor.
# No es una probabilidad; calibrarlo con preguntas de desarrollo.
# MAX_DISTANCE=0.6
# Juez de alucinación (evaluate --judge y JUDGE_REQUESTS). Sin valor usa CHAT_MODEL;
# un modelo mayor, como gemma3:4b, juzga con más fiabilidad.
# JUDGE_MODEL=gemma3:4b
# Juzga cada /ask en segundo plano y registra el resultado; duplica el uso de CPU.
# JUDGE_REQUESTS=false
# Registro JSON de eventos, errores y evaluaciones; vacío = solo stdout.
# LOG_FILE=data/logs/app.log
